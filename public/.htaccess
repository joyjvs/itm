<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # No reescribir si ya es index.html
  RewriteRule ^index\.html$ - [L]

  # Si no es un archivo real ni carpeta real → servir index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>